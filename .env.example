# Copy to .env.local for `npm run dev`. Leave ANTHROPIC_API_KEY unset to get demo answers.
ANTHROPIC_API_KEY=
# Swarm model. Default is the current Opus; set claude-sonnet-5-5 for a cheaper swarm.
SWARM_MODEL=claude-opus-5-5
APP_URL=http://localhost:3000

# Auth + cron. Generate each with: openssl rand -hex 32
SESSION_SECRET=
CRON_SECRET=
INBOUND_SECRET=

# Email — Resend. Unset = dry-run (the full message, magic link included, is printed to the server log).
RESEND_API_KEY=

# Willie's channels (unset = dry-run)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local D1 for `npm run dev`: `npm run db:local` once, then bindings come from .wrangler/state.
